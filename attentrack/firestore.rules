rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /channels/{channelId} {
      allow read, write: if request.auth != null
        && request.auth.uid != null
        // Restrict DMs to participants only
        && (resource.data.type != 'dm' || request.auth.uid in resource.data.members || request.auth.token.email in resource.data.members);

      match /messages/{messageId} {
        // Inherits channel security in real-world scenarios but let's be explicit
        allow read: if request.auth != null
          && request.auth.uid != null
          && (get(/databases/$(database)/documents/channels/$(channelId)).data.type != 'dm' 
              || request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.members
              || request.auth.token.email in get(/databases/$(database)/documents/channels/$(channelId)).data.members);

        allow create: if request.auth != null
          && request.auth.uid != null
          && request.auth.token.email != null
          && request.auth.token.email.size() > 0
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.senderId is string
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 100
          && request.resource.data.createdAt is timestamp
          && request.resource.data.readBy is array;

        allow update: if request.auth != null
          && request.auth.uid != null
          && request.auth.token.email != null
          && request.auth.token.email.size() > 0;

        allow delete: if false;
      }

      match /typing/{typingId} {
        allow read: if request.auth != null
          && request.auth.uid != null
          && request.auth.token.email != null
          && request.auth.token.email.size() > 0;

        allow create, update: if request.auth != null
          && request.auth.uid != null
          && request.auth.token.email != null
          && request.auth.token.email.size() > 0;

        allow delete: if request.auth != null
          && request.auth.uid != null;
      }
    }

    match /presence/{userId} {
      allow read: if request.auth != null
        && request.auth.uid != null
        && request.auth.token.email != null
        && request.auth.token.email.size() > 0;

      allow write: if request.auth != null
        && request.auth.uid != null
        && request.auth.token.email != null
        && request.auth.token.email.size() > 0
        && request.resource.data.userId == request.auth.uid;
    }
  }
}